# Start from the repository root. Defaults run without model downloads.
LMAANA_DATA_DIR=data
# Selected ASR for the next milestone; transcription is not implemented yet.
LMAANA_ASR_MODEL=Lmaana/lmaana-2.4
LMAANA_ASR_REVISION=537c5e5a0e2b1015b5ad10798be54f66bc3a2d7a
# Keep unavailable until the native fairseq2/OmniASR runtime is validated.
LMAANA_ASR_BACKEND=unavailable
LMAANA_ASR_MODEL_DIR=D:/darija_asr_data/models/lmaana-2.4
LMAANA_EMBEDDING_BACKEND=lexical
LMAANA_GENERATOR_BACKEND=excerpt
# Scores are uncalibrated development thresholds, not confidence probabilities.
LMAANA_MIN_SCORE=0.18

# Neural profile: install .[models], pin a Hugging Face commit, then re-ingest.
# LMAANA_EMBEDDING_BACKEND=qwen
# LMAANA_EMBEDDING_REVISION=<full checkpoint commit hash>
# LMAANA_EMBEDDING_DEVICE=cpu
# LMAANA_GENERATOR_BACKEND=llamacpp
# LMAANA_LLM_URL=http://127.0.0.1:8080
# LMAANA_LLM_MODEL=lmaana-qwen3
# Alternative local generation via Ollama, independent of embedding selection.
# LMAANA_GENERATOR_BACKEND=ollama
# LMAANA_OLLAMA_URL=http://127.0.0.1:11434
# LMAANA_OLLAMA_MODEL=qwen3:4b
# LMAANA_OLLAMA_MODEL_DIGEST=<64-character digest from ollama /api/tags>
# Use 8192 context tokens for the conservative Ollama byte-budget preflight.
LMAANA_CONTEXT_TOKENS=4096
LMAANA_MAX_OUTPUT_TOKENS=512
LMAANA_TIMEOUT_SECONDS=60
